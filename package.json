{
  "name": "school-website",
  "private": true,
  "scripts": {
    "predev": "bun scripts/boot-heal.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=1024 --expose-gc' next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "bun run scripts/db-setup.mjs",
    "db:reset": "rm -rf .data/pglite .data/media && bun run scripts/db-setup.mjs",
    "backup": "bash scripts/backup-push.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@electric-sql/pglite": "^0.3.14",
    "archiver": "^8.0.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.49.0",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/archiver": "^8.0.0",
    "@types/node": "22.19.15",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
