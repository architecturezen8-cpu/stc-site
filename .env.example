# ═══════════════════════════════════════════════════════════════════════════
# St. Thomas' College, Matale — school website + LMS
#
# THIS FILE IS A TEMPLATE (safe to be public). The REAL `.env` is NEVER
# committed to this repository, because the origin repo (sasikadiv-cyber/School)
# is PUBLIC and `.env` holds live secrets (database password, backup token).
#
# WHERE THE REAL VALUES LIVE — 3 recovery layers, in order:
#   1. scripts/boot-heal.mjs — runs automatically before every `bun run dev`
#      and rebuilds `.env` from /home/z/backups/stc-env-latest (a copy kept
#      OUTSIDE the project so sandbox resets cannot touch it)
#      + .env.supabase-backup inside the project as a second local fallback.
#   2. The PRIVATE backup mirror (github.com/novaartstorelk-alt/school-site-backups),
#      branch `env-snapshot` — scripts/backup-push.sh commits the real `.env`
#      there on every `bun run backup`. NEVER pushed to this public repo.
#      Restore with:
#          git fetch backup env-snapshot
#          git show FETCH_HEAD:.env > .env
#   3. The owner (Sasika) keeps the Supabase database password + GitHub token.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# LIVE DATABASE — the app reads SITE_DATABASE_URL first (SITE_ prefix exists so
# a sandbox-global legacy DATABASE_URL can never shadow it). Local PGlite is
# the rollback/dev fallback.
# ─────────────────────────────────────────────────────────────────────────────
SITE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=pglite:/home/z/my-project/db/custom.db

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (project ref gaiostdtlkdvyuikcjvf)
# URL is public; the anon key is public-by-design (it ships in the browser
# bundle) — but keep both here as placeholders so restores stay explicit.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY — Supabase Dashboard → Settings → API>

# ─────────────────────────────────────────────────────────────────────────────
# OFF-SITE BACKUP MIRROR (PRIVATE repo). The x-access-token IS a secret —
# never put the real URL in any tracked file.
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_GIT_URL=https://x-access-token:<GITHUB_TOKEN>@github.com/novaartstorelk-alt/school-site-backups.git

# Public origin of this deployment (used for OAuth redirect pins, absolute URLs)
PUBLIC_SITE_URL=https://<DEPLOYMENT-HOST>

# ─────────────────────────────────────────────────────────────────────────────
# Media storage — local (default), minio, or r2 (B2 is S3-compatible → use the
# same env block when Backblaze B2 is adopted)
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_STORAGE_DRIVER=local
MEDIA_KEEP_ORIGINALS=false

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=school-media
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/school-media

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Future Supabase Auth (admin-side) — empty until Phase 2.3 resumes
# ─────────────────────────────────────────────────────────────────────────────
DIRECT_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_SESSION_DATABASE_URL=
SUPABASE_DIRECT_DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── v2.8.81.0 — Office form notifications (the THIRD essential mail event) ──
# When a public form is submitted (Grade 6 / A/L application, appointment,
# contact message) the office gets a one-way heads-up email. The recipient
# defaults to the PUBLISHED site-settings email (Admin Studio → Settings,
# currently admissions@stcmatale.lk) and falls back to MAIL_SENDER.
# Set FORM_NOTIFY_EMAIL to redirect the notifications to another inbox.
FORM_NOTIFY_EMAIL=
